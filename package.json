{
  "name": "ui-elements",
  "version": "10.1.15",
  "description": "A repo of ui elements",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/localnerve/ui-elements.git"
  },
  "scripts": {
    "rmdist": "node -e 'require(\"fs\").rmSync(\"dist\", {recursive:true,force:true})'",
    "prebuild": "npm run rmdist",
    "build": "nbs --series installs webpack copy",
    "prebuild:dev": "npm run rmdist",
    "build:dev": "nbs --series webpack-dev copy",
    "lint": "eslint .",
    "installs": "nbs installs",
    "copy": "nbs copy",
    "dev": "npm run build:dev && node index.js",
    "test": "npm run build && npm run lint && playwright test",
    "test:debug": "npm run build && npm run lint && playwright test --headed --timeout=60000",
    "start": "npm run build && node index.js"
  },
  "keywords": [
    "localnerve",
    "ui",
    "elements"
  ],
  "author": "Alex Grant <alex@localnerve.com> (https://www.localnerve.com)",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "babel-loader": "^10.1.1",
    "eslint": "^10.14.0",
    "eslint-plugin-n": "18.5.0",
    "express": "^5.3.0",
    "globals": "^17.14.0",
    "node-build-stream": "^1.0.1",
    "picklr": "latest",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
